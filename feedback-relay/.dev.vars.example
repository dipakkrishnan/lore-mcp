# Fine-grained GitHub PAT, scoped to dipakkrishnan/lore-mcp only, with
# exactly one permission: Issues -> Read and write. Never a classic token,
# never repo-wide write.
LORE_FEEDBACK_GITHUB_TOKEN=github_pat_...
# PostHog project API key (phc_...). Without it /events accepts and keeps nothing.
POSTHOG_KEY=phc_...
