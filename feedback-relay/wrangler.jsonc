{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lore-feedback-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  // No nodejs_compat: nothing here needs Node built-ins, and the smaller the
  // relay's surface the better — it is the one Worker that holds a token
  // capable of writing to the project's issue tracker.
  "observability": { "enabled": true },
  "vars": {
    // Overridable so tests point at a stubbed GitHub instead of the real API.
    "LORE_GITHUB_API": "https://api.github.com"
  },
  // Both keyed in src/limit.ts: FEEDBACK_RATE_LIMIT per client IP,
  // GLOBAL_RATE_LIMIT on a constant key so an IP-rotating caller cannot
  // still flood the issue tracker or burn the token's GitHub quota.
  // `period` accepts only 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
