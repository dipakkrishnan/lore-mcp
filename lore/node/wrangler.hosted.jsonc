{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // XC-088: Lore's hosted stores, one Durable Object each at <store>.yourlore.dev
  // (contracts/hosted-inbox.md). Maintainer-owned, deployed only from CI on main by
  // .github/workflows/deploy-hosted.yml — never an owner's node, and never from a laptop.
  "name": "lore-hosted",
  "main": "src/hosted/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Every store is a subdomain, and the zone needs a proxied wildcard DNS record. This route
  // runs in front of the zone's custom domains (relay., checkout., www.), and fetch() can't
  // reach them from here (global_fetch_strictly_public loops back into this route), so the
  // Worker hands their requests to those Workers by name.
  "routes": [{ "pattern": "*.yourlore.dev/*", "zone_name": "yourlore.dev" }],
  "services": [
    { "binding": "RELAY", "service": "lore-feedback-relay" },
    { "binding": "CHECKOUT", "service": "lore-checkout" },
    { "binding": "SITE", "service": "yourlore-site" }
  ],
  "workers_dev": false,
  "vars": { "STORE_DOMAIN": "yourlore.dev" },
  // Logs only, and no invocation logs: those record each request's URL, and a URL-only
  // connector's carries its agent key (/agent/lore_agent_…). Bodies and saves are never logged.
  "observability": { "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "ratelimits": [{ "name": "CLAIMS", "namespace_id": "1088", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "STORES", "class_name": "HostedStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostedStore"] }]
}
