{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lore",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Overridable so tests can point at a stubbed facilitator; unset in
    // deployment leaves this default in place.
    "LORE_FACILITATOR_URL": "https://x402.org/facilitator"
  },
  // Cloudflare's own request traces and logs (XC-028/MON-020) — stored in
  // and readable only from the owner's own Cloudflare account. No
  // `destinations` here: an owner who wants OTLP export configures a
  // destination in their own dashboard and adds it themselves. Full
  // sampling suits alpha volume; an owner whose node gets busy should lower
  // `head_sampling_rate` — they pay for their own observability.
  "observability": {
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "logs": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LorePaidMCP",
        "name": "LorePaidMCP"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["LorePaidMCP"],
      "tag": "v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "LORE_DB",
      "database_name": "lore-publications",
      // Per-account: create with `npx wrangler d1 create lore-publications`
      // and paste the id it prints. Local dev (`npm run dev`) needs no id.
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  // The maintainers' own standing target (MON-008), deployed by
  // .github/workflows/deploy-qa.yml on every merge to main — never an
  // owner's node. Bindings and durable objects are not inherited from the
  // default environment above, so they are repeated here in full rather
  // than partially, which is what Wrangler actually requires.
  "env": {
    "qa": {
      "name": "lore-qa",
      "vars": {
        "LORE_FACILITATOR_URL": "https://x402.org/facilitator"
      },
      // Same traces/logs as the default env above; MON-021 tracks pointing
      // this at an OTLP `destinations` entry once one exists in the
      // maintainers' Cloudflare dashboard (a destination cannot be created
      // from this file — same blocker shape as MON-016).
      "observability": {
        "traces": { "enabled": true, "head_sampling_rate": 1 },
        "logs": { "enabled": true }
      },
      "durable_objects": {
        "bindings": [
          {
            "class_name": "LorePaidMCP",
            "name": "LorePaidMCP"
          }
        ]
      },
      "migrations": [
        {
          "new_sqlite_classes": ["LorePaidMCP"],
          "tag": "v1"
        }
      ],
      "d1_databases": [
        {
          "binding": "LORE_DB",
          "database_name": "lore-publications-qa",
          // Resolved automatically on the first run of
          // .github/workflows/deploy-qa.yml, which creates the database and
          // commits the real id back over this placeholder — never hand-edit.
          "database_id": "REPLACE_WITH_YOUR_QA_D1_ID"
        }
      ]
    }
  }
}
