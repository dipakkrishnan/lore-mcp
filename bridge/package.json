{
  "name": "x402-mcp-bridge",
  "version": "0.1.0",
  "description": "Local stdio MCP server that lets any MCP client call a remote x402-paid MCP server. The signer lives here; the model only ever sees tool results.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx test/policy.test.ts && tsx scripts/test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/evm": "2.28.0",
    "agents": "0.29.0",
    "viem": "2.57.8"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
